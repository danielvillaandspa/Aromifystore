{
  "name": "aromify-checkout",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": "https://shoparomify.store",
    "OWNER_USERNAME": "replace-with-your-username"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aromify-checkout",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 * * * *"] }
}
